NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Luvie's Foods must use its own dedicated Firebase project; never reuse another client's credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Existing customer-conversation attachments use the configured Firebase bucket; menu and announcement media use UploadThing.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Server-side Firebase Admin service account JSON for Vercel.
FIREBASE_ADMIN_KEY=

# UploadThing token for Luvie's Foods menu and announcement media.
UPLOADTHING_TOKEN=

# GitHub Actions Firebase rules deployment (dedicated Luvie's Foods project).
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
